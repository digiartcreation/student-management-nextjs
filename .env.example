DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME"
JWT_SECRET="CHANGE_THIS_SECRET_TO_A_LONG_RANDOM_VALUE"
NODE_ENV="development"

# The origin the browser loads the app from. Only used for CORS headers, so when
# the UI and API are served together (the Hostinger setup — see docs/DEPLOY.md)
# it simply matches the site's own URL and no cross-origin request is ever made.
FRONTEND_URL="http://localhost:4200"

SCHOOL_NAME="Student Fee Management School"
SCHOOL_ADDRESS="School Address"
